#!/usr/bin/env bash
# difftool-review: open a difftool review in a new herdr tab and return when
# the reviewer quits it. Meant for agents: run it, block on it, then read the
# notes sidecar. Any arguments are passed to difftool (default: -git).
#
#   difftool-review              # working tree vs HEAD, notes auto-detected
#   difftool-review -git HEAD~3
#
# Prints a one-line summary of the sidecar and exits 0 when the review
# closed, non-zero when herdr is unavailable or difftool did not start.
set -euo pipefail

if [[ -z "${HERDR_SOCKET_PATH:-}" ]] || ! command -v herdr >/dev/null; then
	echo "difftool-review: needs a running herdr session" >&2
	exit 2
fi
root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
args=("$@")
[[ ${#args[@]} -eq 0 ]] && args=(-git)

created=$(herdr tab create --cwd "$root" --label "review: $(basename "$root")" --focus)
read -r tab pane < <(printf '%s' "$created" | python3 -c \
	'import json,sys; r=json.load(sys.stdin)["result"]; print(r["tab"]["tab_id"], r["root_pane"]["pane_id"])')
trap 'herdr tab close "$tab" >/dev/null 2>&1 || true' EXIT

# foreground reports the name of the pane's foreground process ("fish",
# "difftool", ...). The review is tracked through it rather than by
# scraping the screen: the diff itself may show any marker text.
foreground() {
	herdr pane process-info --pane "$pane" 2>/dev/null | python3 -c \
		'import json,sys; p=json.load(sys.stdin)["result"]["process_info"]["foreground_processes"]; print(p[-1]["name"] if p else "")' 2>/dev/null || true
}

# the shell prompt takes a moment; typing before it is up loses the command
herdr pane wait-output --regex '[❯$#] ?$' --source visible --timeout 30000 "$pane" >/dev/null
herdr pane run "$pane" "difftool $(printf '%q ' "${args[@]}")" >/dev/null
for _ in $(seq 1 60); do
	[[ $(foreground) == difftool ]] && break
	sleep 0.5
done
if [[ $(foreground) != difftool ]]; then
	echo "difftool-review: difftool did not start:" >&2
	herdr pane read --source visible "$pane" | grep . | tail -5 >&2
	exit 1
fi
while [[ $(foreground) == difftool ]]; do
	sleep 1
done

sidecar="$root/.difftool-notes.json"
[[ -f $sidecar ]] || { echo "review closed · no notes file"; exit 0; }
python3 - "$sidecar" <<'EOF'
import json, sys
notes = json.load(open(sys.argv[1]))["comments"]
yours = sum(1 for n in notes if n.get("author") == "human" and not n.get("resolved"))
resolved = sum(1 for n in notes if n.get("resolved"))
print(f"review closed · {yours} notes from you · {resolved} resolved · {len(notes)} total · {sys.argv[1]}")
EOF
